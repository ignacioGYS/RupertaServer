# Copia este archivo a .env y ajusta los valores

# Desarrollo en tu PC: IP del servidor remoto
# Servidor con Docker: host.docker.internal
# Servidor sin Docker (PM2): 127.0.0.1
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USER=nacho
SSH_PASSWORD=tu_password_aqui

# Puerto de la app
PORT=3001

# 0.0.0.0 para que sea accesible desde la VPN
HOST=0.0.0.0

# qBittorrent WebUI (usuario actual: ignacio). Sin esto, Hoy en casa no puede pausar/limitar.
QBIT_USER=ignacio
QBIT_PASSWORD=

# Opcional: si Plex no está en el mismo host
# PLEX_URL=http://192.168.1.63:32400
# PLEX_TOKEN=

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=ruperta
DB_PASSWORD=ruperta_secure_pass
DB_NAME=ruperta_monitor
